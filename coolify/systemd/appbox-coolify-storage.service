[Unit]
Description=Prepare the Coolify VM data filesystem
# Docker's socket starts before basic.target. Storage must run that early too.
DefaultDependencies=no
After=local-fs.target
Conflicts=shutdown.target
Before=docker.service docker.socket containerd.service shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/appbox-coolify/storage.py
TimeoutStartSec=900
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=multi-user.target
