[Unit]
Description=Xvfb Virtual Display Server

[Service]
Type=simple
User=appbox
Group=appbox
Environment=DISPLAY=:1
Environment=DISPLAY_CDEPTH=24
Environment=DISPLAY_DPI=96
Environment=DRINODE=
Environment=MAX_RES=7680x4320
Environment=DISABLE_ZINK=false
ExecStart=/bin/bash -c 'VFBDEVICE=""; if [ -n "$DRINODE" ] && [ -r "$DRINODE" ]; then VFBDEVICE="$DRINODE"; fi; if [ -n "$VFBDEVICE" ]; then echo "xvfb: using explicit render node $VFBDEVICE"; exec /usr/bin/Xvfb $DISPLAY -screen 0 "${MAX_RES}x${DISPLAY_CDEPTH}" -dpi "$DISPLAY_DPI" +extension "COMPOSITE" +extension "DAMAGE" +extension "RANDR" +extension "RENDER" +extension "MIT-SHM" +extension "XFIXES" +extension "XTEST" +render -nolisten "tcp" -ac -noreset -shmem -vfbdevice "$VFBDEVICE"; else echo "xvfb: starting without -vfbdevice (set DRINODE to force one)"; exec /usr/bin/Xvfb $DISPLAY -screen 0 "${MAX_RES}x${DISPLAY_CDEPTH}" -dpi "$DISPLAY_DPI" +extension "COMPOSITE" +extension "DAMAGE" +extension "RANDR" +extension "RENDER" +extension "MIT-SHM" +extension "XFIXES" +extension "XTEST" +render -nolisten "tcp" -ac -noreset -shmem; fi'
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10

[Install]
# No WantedBy - this service is started by dependency chain 